POSTGRES_DB=todorok
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-admin-password
PLANNER_DB_PASSWORD=replace-with-planner-password
ACTIVITY_DB_PASSWORD=replace-with-activity-password
NOTIFICATION_DB_PASSWORD=replace-with-notification-password
DEBEZIUM_DB_PASSWORD=replace-with-debezium-password
DATABASE_CREDENTIAL_UPDATE=false
CONNECTOR_CONFIG_UPDATE=false
AUTH_ISSUER=todorok
AUTH_AUDIENCE=todorok-api
AUTH_ALLOWED_ORIGINS=http://localhost
AUTH_PUBLIC_KEY_FILE=../../.local/auth/public.pem
AUTH_PRIVATE_KEY_FILE=../../.local/auth/private.pem
# Optional template approval override: infra/docker/compose.template-service.yml
# Set separate absolute host key paths when enabling the override.
# TODOROK_TEMPLATE_SERVICE_PRIVATE_KEY_FILE=C:/path/to/template-service/private.pem
# TODOROK_TEMPLATE_SERVICE_PUBLIC_KEY_FILE=C:/path/to/template-service/public.pem
# HTTP development only. Production must use TLS, Secure=true, and no local profile.
SPRING_PROFILES_ACTIVE=local
AUTH_COOKIE_SECURE=false
