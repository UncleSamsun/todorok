{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todorok.local/contracts/catalog/program-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogKey", "version", "checksum", "name", "source", "sessionsPerWeek", "weeks"],
  "properties": {
    "catalogKey": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "integer", "minimum": 1 },
    "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": { "type": "string", "enum": ["SYNTHETIC", "PRIVATE_VERIFIED"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "format": "uri", "maxLength": 2048 },
        "conditions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "cautions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "sessionsPerWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["week", "sessions"],
        "properties": {
          "week": { "type": "integer", "minimum": 1 },
          "sessions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["session", "sets", "targetTotal"],
              "properties": {
                "session": { "type": "integer", "minimum": 1 },
                "sets": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 100000 } },
                "targetTotal": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
