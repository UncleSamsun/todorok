{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todorok.app/schemas/events/activity-voided/v1",
  "title": "Activity voided event v1",
  "type": "object",
  "required": ["eventId", "type", "version", "aggregateVersion", "occurredAt", "userId", "payload"],
  "allOf": [
    { "$ref": "https://todorok.app/schemas/events/envelope/v1" },
    {
      "properties": {
        "type": { "const": "ACTIVITY_VOIDED" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activityId", "taskId", "voidedAt", "reason"],
          "properties": {
            "activityId": { "type": "string", "format": "uuid" },
            "taskId": { "type": "string", "format": "uuid" },
            "voidedAt": { "type": "string", "format": "date-time" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  ]
}
