{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todorok.app/schemas/events/notification-preference-changed/v1",
  "title": "Notification preference changed event v1",
  "type": "object",
  "required": ["eventId", "type", "version", "aggregateVersion", "occurredAt", "userId", "payload"],
  "allOf": [
    { "$ref": "https://todorok.app/schemas/events/envelope/v1" },
    { "properties": { "type": { "const": "NOTIFICATION_PREFERENCE_CHANGED" }, "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["notificationsEnabled", "summaryTime"],
      "properties": {
        "notificationsEnabled": { "type": "boolean" },
        "summaryTime": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    } } }
  ]
}
