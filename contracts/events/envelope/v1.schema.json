{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todorok.app/schemas/events/envelope/v1",
  "title": "Event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "type", "version", "aggregateVersion", "occurredAt", "userId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "aggregateVersion": { "type": "integer", "minimum": 0 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "userId": { "type": "string", "format": "uuid" },
    "payload": { "type": "object" }
  }
}
