{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todorok.app/schemas/events/series-changed/v2",
  "x-java-name": "SeriesChangedV2",
  "allOf": [
    {
      "$ref": "https://todorok.app/schemas/events/envelope/v1"
    },
    {
      "properties": {
        "type": {
          "const": "SERIES_CHANGED"
        },
        "version": {
          "const": 2
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seriesId",
            "command",
            "templateLink"
          ],
          "properties": {
            "seriesId": {
              "type": "string",
              "format": "uuid"
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "templateLink": {
              "anyOf": [
                {
                  "$ref": "https://todorok.app/schemas/events/template-binding-link/v1"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  ]
}
