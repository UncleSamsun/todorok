{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todorok.app/schemas/events/activity-corrected/v1",
  "title": "Activity corrected event v1",
  "type": "object",
  "required": ["eventId", "type", "version", "aggregateVersion", "occurredAt", "userId", "payload"],
  "allOf": [
    { "$ref": "https://todorok.app/schemas/events/envelope/v1" },
    {
      "properties": {
        "type": { "const": "ACTIVITY_CORRECTED" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activityId", "taskId", "activityType", "completedAt", "outcome", "previousPerformedAt", "completionStatus"],
          "properties": {
            "activityId": { "type": "string", "format": "uuid" },
            "taskId": { "type": "string", "format": "uuid" },
            "activityType": { "enum": ["WORKOUT", "STUDY", "CLIMBING"] },
            "completionStatus": { "enum": ["COMPLETED", "PARTIAL"] },
            "completedAt": { "type": "string", "format": "date-time" },
            "previousPerformedAt": { "type": "string", "format": "date-time" },
            "startedAt": { "type": ["string", "null"], "format": "date-time" },
            "endedAt": { "type": ["string", "null"], "format": "date-time" },
            "outcome": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  ]
}
